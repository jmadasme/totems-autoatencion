# ============================================================
#  TotemGetnetIM30 — Plantilla de variables de entorno
#  Copie este archivo a `.env` y complete los valores reales.
#  NUNCA commitee `.env` (está en .gitignore).
# ============================================================

# --- Modo de operación -------------------------------------
# simulation | sandbox | production
# simulation fuerza el conector simulado (sin hardware ni credenciales).
GETNET_MODE=simulation

# --- Transporte del Connector ------------------------------
# usb | http | cloud | app2app
# app2app = dispara la app de pagos de Getnet del IM30 por ADB (Intents).
GETNET_CONNECTOR=usb

# --- App2App (ADB / Intents Android) -----------------------
# Serial del terminal (vacío = autodetecta con `adb devices`).
GETNET_ADB_SERIAL=
# Binario adb (o ruta absoluta).
GETNET_ADB_PATH=adb
# Paquete y actividad de la app de pagos de Getnet en el IM30.
GETNET_APP2APP_PACKAGE=cl.getnet.payment.prod2
GETNET_APP2APP_ACTIVITY=cl.getnet.payment.ApiActivity
# Timeouts de la app (ms): espera del resultado y de acercar tarjeta.
GETNET_APP2APP_PAYMENT_TIMEOUT_MS=120000
GETNET_APP2APP_PLACE_CARD_TIMEOUT_MS=60000
# Intervalo de sondeo de logcat (s).
GETNET_APP2APP_POLL_INTERVAL=1.5
# Si el terminal imprime el comprobante (false = lo imprime el tótem).
GETNET_APP2APP_PRINT_ON_POS=false

# --- Puerto serie del PAX IM30 -----------------------------
# Vacío = autodetección por by-id. También puede indicar:
#   /dev/ttyACM1  o  /dev/serial/by-id/usb-PAX_IM30_1640353821-if02
GETNET_SERIAL_PORT=
# Interfaz preferida si se autodetecta: if02 (ttyACM1) o if04 (ttyACM2)
GETNET_SERIAL_PREFERENCE=if02
GETNET_BAUDRATE=57600
GETNET_MAX_RETRIES=2
GETNET_RETRY_BACKOFF=1.0

# --- Credenciales Getnet (SECRETAS) ------------------------
GETNET_TERMINAL_ID=
GETNET_MERCHANT_ID=
GETNET_COMMERCE_CODE=

# --- Fallback HTTP (CreateHttp) ----------------------------
GETNET_HTTP_HOST=127.0.0.1
GETNET_HTTP_PORT=8080

# --- Cloud2Cloud (CreateCloud) -----------------------------
GETNET_CLOUD_URL=
GETNET_API_KEY=
[REDACTED]
GETNET_CLIENT_SECRET=

# --- Tótem / app -------------------------------------------
ORDER_TIMEOUT_SECONDS=120
IDLE_TIMEOUT_SECONDS=60
DB_PATH=data/orders.db
APP_HOST=0.0.0.0
APP_PORT=8000
CURRENCY=CLP
MIN_AMOUNT=1
MAX_AMOUNT=999999

# --- Simulación --------------------------------------------
# approved | declined | timeout | error | random
GETNET_SIM_OUTCOME=approved
# approved | declined | error  (resultado simulado de refund/void)
GETNET_SIM_REFUND_OUTCOME=approved
GETNET_SIM_DELAY=1.5
GETNET_SIM_APPROVE_PROB=1.0
